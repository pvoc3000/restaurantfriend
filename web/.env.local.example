# Copy this file to `web/.env.local` and fill in the anon key.
# `.env.local` is gitignored — never commit real keys.
#
# Both values come from Supabase Studio → Settings → API for project
# kltxioacvneshbyhxtaj. Only the two NEXT_PUBLIC_ values below belong here;
# the `service_role` key must never appear in web/ (it bypasses RLS and is
# for local migration scripts only).

# Project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://kltxioacvneshbyhxtaj.supabase.co

# Publishable/anon key (Settings → API → Project API keys → anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where THIS app lives, as a customer would reach it. It goes into the
# approval link on a quote (decision 17), so it must never be localhost: a
# quote composed on a dev server would otherwise carry a link that works for
# nobody but the machine that sent it.
#
# In production the browser's own origin is already right, so this is optional
# there. In DEVELOPMENT it is required — without it the compose card refuses to
# open a quote rather than producing a draft the recipient can't use.
#
# Keep it equal to the APP_URL edge-function secret; the send refuses a
# mismatch and names the value it expected.
NEXT_PUBLIC_APP_URL=https://restaurantfriend.vercel.app
