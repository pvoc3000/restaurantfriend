{
  "//": "Compiles the fixtures and the pure modules they exercise to CommonJS so plain Node can run them. The app's own tsconfig is noEmit; this is the only place that emits.",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "../../.fixtures-build",
    "rootDir": "../..",
    "incremental": false,
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "../../src/lib/attachments.ts",
    "../../src/lib/fileTypes.ts",
    "../../src/lib/columnOrder.ts",
    "../../src/lib/employees.ts",
    "../../src/lib/employeeEvents.ts",
    "../../src/lib/columnVisibility.ts",
    "../../src/lib/receiving.ts",
    "../../src/lib/invoiceMatch.ts",
    "../../src/lib/invoiceExtraction.ts",
    "../../src/lib/purchaseOrders.ts",
    "../../src/lib/payPeriods.ts",
    "../../src/lib/timeZone.ts",
    "../../src/lib/timesheets.ts",
    "../../src/lib/overtime.ts",
    "../../src/lib/breakRules.ts",
    "../../src/lib/tipPool.ts",
    "../../src/lib/homebaseImport.ts",
    "../../src/lib/gustoExport.ts",
    "../../src/lib/productionPrice.ts",
    "../../src/lib/productionPlans.ts",
    "../../src/lib/production.ts",
    "../../src/lib/recipeCosts.ts",
    "../../src/lib/recipes.ts"
  ]
}
